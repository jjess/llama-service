# Qwen3.6-35B-A3B-UD (unsloth, IQ2_M) — speculative decoding with draft-mtp
#: "${LLAMA_MODEL:=${LLAMA_MODELS_DIR}/unsloth/unsloth-Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-UD-IQ2_M.gguf}"
#: "${LLAMA_MODEL:=${LLAMA_MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-UD-IQ2_M.gguf}"
#: "${LLAMA_MODEL:=${LLAMA_MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-Q2_K_XL.gguf}"
: "${LLAMA_MODEL:=${LLAMA_MODELS_DIR}/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-IQ3_XXS.gguf}"

: "${LLAMA_MMPROJ:=}"

: "${LLAMA_HOST:=0.0.0.0}"
: "${LLAMA_PORT:=8080}"

# Speculative decoding
: "${LLAMA_SPEC_TYPE:=draft-mtp}"
: "${LLAMA_SPEC_DRAFT_N_MAX:=3}"

# Sampling / generation
: "${LLAMA_TEMP:=1.0}"
: "${LLAMA_TOP_P:=0.95}"
: "${LLAMA_TOP_K:=20}"
: "${LLAMA_MIN_P:=0.0}"
: "${LLAMA_PRESENCE_PENALTY:=0.0}"
: "${LLAMA_REPEAT_PENALTY:=1.0}"

# Batching / context
: "${LLAMA_CTX_SIZE:=65536}"
: "${LLAMA_BATCH_SIZE:=512}"
: "${LLAMA_UBATCH_SIZE:=128}"
: "${LLAMA_PARALLEL:=1}"
: "${LLAMA_N_GPU_LAYERS:=999}"

# Cache / precision
: "${LLAMA_CACHE_TYPE_K:=q8_0}"
: "${LLAMA_CACHE_TYPE_V:=q8_0}"

# Flash attention / verbosity
: "${LLAMA_FLASH_ATTN:=on}"
: "${LLAMA_VERBOSITY:=4}"

: "${LLAMA_SLEEP_IDLE_SECONDS:=300}"

# desactivar opciones que hacen que falle
#: "${LLAMA_NO_DIRECT_IO:}"
qwen3.6-35b-ud.env
# Chat template kwargs
#: "${LLAMA_CHAT_TEMPLATE_KWARGS:={\"reasoning_effort\":\"medium\"}}"

# API key alias (matches the --alias from the original script)
#qwen3.6-35b-ud.env#: "${LLAMA_API_KEY:=alias:Qwen3.6-35B-A3B-UD-IQ2-M}"
